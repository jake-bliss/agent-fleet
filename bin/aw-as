#!/usr/bin/env bash
# aw-as <handle> <aw args...>: run aw as the agent whose credentials sit in ~/.config/aw/<handle>.
set -uo pipefail

if [[ $# -lt 2 || ! "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
  echo "Usage: aw-as <handle> <aw args...>" >&2
  exit 2
fi
handle="$1"; shift
f="$HOME/.config/aw/$handle"
[[ -f "$f" && ! -L "$f" ]] || { echo "aw-as: no credentials file $f" >&2; exit 1; }
mode="$(stat -c %a "$f" 2>/dev/null || stat -f %Lp "$f" 2>/dev/null)"
owner="$(stat -c %u "$f" 2>/dev/null || stat -f %u "$f" 2>/dev/null)"
[[ "$mode" == 600 && "$owner" == "$(id -u)" ]] || { echo "aw-as: $f must be mode 0600 and owned by you" >&2; exit 1; }

trim() { local x="$1"; x="${x#"${x%%[![:space:]]*}"}"; printf '%s' "${x%"${x##*[![:space:]]}"}"; }
declare -A cfg=()
while IFS= read -r line || [[ -n "$line" ]]; do
  line="$(trim "$line")"
  [[ "$line" == \#* || "$line" != *=* || "$line" == =* ]] && continue
  k="$(trim "${line%%=*}")" v="$(trim "${line#*=}")"
  v="${v%\"}"; v="${v#\"}"
  case "$k" in AW_URL|AW_TOKEN|AW_ACCESS_CLIENT_ID|AW_ACCESS_CLIENT_SECRET) cfg[$k]="$v" ;; esac
done <"$f"
[[ -n "${cfg[AW_URL]:-}" && -n "${cfg[AW_TOKEN]:-}" ]] || { echo "aw-as: $f lacks AW_URL/AW_TOKEN" >&2; exit 1; }

unset AW_URL AW_TOKEN AW_ACCESS_CLIENT_ID AW_ACCESS_CLIENT_SECRET
for k in "${!cfg[@]}"; do export "$k=${cfg[$k]}"; done
exec aw "$@"
