#!/usr/bin/env python3
"""prune-worktrees: remove worktrees whose branch has a MERGED or CLOSED PR.

Not `git branch --merged`: squash-merged branches still report as unmerged, so
PR state from GitHub (via gh) is the only reliable signal.

Safety:
  - never uses --force, so a worktree with uncommitted or untracked work refuses and survives
  - never touches the main checkout, detached worktrees, or branches with an OPEN PR
  - never touches a branch with NO PR at all (that is unpushed work)
  - never touches a worktree a running process has as its cwd (a live session)
  - never touches a worktree whose HEAD has commits the finished PR's head does not contain
  - dry-run by default; pass --apply to actually remove

Usage: prune-worktrees <repo-path> [--apply]
"""
import json
import os
import subprocess
import sys


def sh(args, **kw):
    return subprocess.run(args, capture_output=True, text=True, **kw)


def pr_rows(repo, state):
    out = sh(["gh", "pr", "list", "--state", state, "--limit", "1000",
              "--json", "headRefName,state,headRefOid,number"], cwd=repo)
    if out.returncode != 0:
        sys.exit(f"prune-worktrees: gh failed for state={state}: {out.stderr.strip()}")
    return json.loads(out.stdout or "[]")


def worktrees(repo):
    out = sh(["git", "worktree", "list", "--porcelain"], cwd=repo)
    entries, cur = [], {}
    for line in out.stdout.splitlines():
        if line.startswith("worktree "):
            if cur:
                entries.append(cur)
            cur = {"path": line[9:], "branch": None}
        elif line.startswith("branch "):
            cur["branch"] = line[7:].replace("refs/heads/", "")
    if cur:
        entries.append(cur)
    return entries


def process_cwds():
    cwds = set()
    if os.path.isdir("/proc/self"):
        for pid in os.listdir("/proc"):
            if pid.isdigit():
                try:
                    cwds.add(os.path.realpath(os.readlink(f"/proc/{pid}/cwd")))
                except OSError:
                    pass
    else:
        out = sh(["lsof", "-a", "-d", "cwd", "-F", "n"])
        if not out.stdout:
            sys.exit("prune-worktrees: lsof returned nothing; cannot tell which worktrees are in use")
        cwds = {os.path.realpath(l[1:]) for l in out.stdout.splitlines() if l.startswith("n/")}
    return cwds


def in_use(path, cwds):
    real = os.path.realpath(path)
    return any(c == real or c.startswith(real + os.sep) for c in cwds)


def contained_in_pr(path, prs):
    """True when every commit on HEAD is already in one of the finished PRs' heads."""
    head = sh(["git", "rev-parse", "HEAD"], cwd=path).stdout.strip()
    if not head:
        return False
    for pr in prs:
        oid = pr.get("headRefOid")
        if not oid:
            continue
        if head == oid:
            return True
        if sh(["git", "cat-file", "-e", f"{oid}^{{commit}}"], cwd=path).returncode != 0:
            try:
                sh(["git", "fetch", "-q", "origin", f"refs/pull/{pr['number']}/head"], cwd=path, timeout=120)
            except subprocess.TimeoutExpired:
                continue
        if sh(["git", "merge-base", "--is-ancestor", head, oid], cwd=path).returncode == 0:
            return True
    return False


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help"):
        print(__doc__)
        return
    repo = os.path.expanduser(sys.argv[1])
    apply = "--apply" in sys.argv[2:]
    if not os.path.isdir(repo):
        sys.exit(f"prune-worktrees: repo path missing: {repo}")

    common = sh(["git", "rev-parse", "--path-format=absolute",
                 "--git-common-dir"], cwd=repo).stdout.strip()
    main_checkout = os.path.dirname(common)

    print(f"prune-worktrees: repo={repo}")
    print("prune-worktrees: fetching PR state (open/merged/closed)...")
    open_b = {r["headRefName"] for r in pr_rows(repo, "open")}
    merged = pr_rows(repo, "merged")
    finished = {}
    for r in merged + [r for r in pr_rows(repo, "closed") if r["state"] == "CLOSED"]:
        finished.setdefault(r["headRefName"], []).append(r)

    # gh caps at 1000; anything unresolved gets a per-branch lookup rather than a guess.
    capped = len(merged) >= 1000

    def finished_prs(branch):
        if branch in finished:
            return finished[branch]
        if branch in open_b or not capped:
            return []
        out = sh(["gh", "pr", "list", "--head", branch, "--state", "all", "--limit", "5",
                  "--json", "headRefName,state,headRefOid,number"], cwd=repo)
        rows = json.loads(out.stdout or "[]")
        if any(r["state"] == "OPEN" for r in rows):
            return []
        return [r for r in rows if r["state"] in ("MERGED", "CLOSED")]

    cwds = process_cwds()
    removed = dirty = kept = no_pr = busy = ahead = 0
    for wt in worktrees(repo):
        path, branch = wt["path"], wt["branch"]
        if path == main_checkout or not branch or branch in open_b:
            kept += 1
            continue
        if not os.path.isdir(path):
            kept += 1
            continue
        prs = finished_prs(branch)
        if not prs:
            no_pr += 1
            continue
        if in_use(path, cwds):
            busy += 1
            print(f"  IN USE, kept: {path}")
            continue
        if not contained_in_pr(path, prs):
            ahead += 1
            print(f"  LOCAL COMMITS, kept: {path}")
            continue
        if not apply:
            print(f"  would remove: {path}  ({branch})")
            removed += 1
            continue
        if sh(["git", "worktree", "remove", path], cwd=repo).returncode == 0:
            removed += 1
        else:
            dirty += 1
            print(f"  DIRTY, kept: {path}")

    if apply:
        sh(["git", "worktree", "prune"], cwd=repo)

    print(f"\nprune-worktrees: removed={removed} dirty-kept={dirty} in-use-kept={busy} "
          f"local-commits-kept={ahead} open-or-main={kept} no-PR-kept={no_pr}")
    if not apply:
        print("prune-worktrees: DRY RUN — re-run with --apply to execute")


if __name__ == "__main__":
    main()
